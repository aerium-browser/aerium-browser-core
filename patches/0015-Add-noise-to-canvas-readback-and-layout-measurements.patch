 namespace blink {
 
+namespace {
+
+bool NoiseKeyFor(ExecutionContext* context, uint64_t* key) {
+  if (!context) {
+    v8::Isolate* isolate = v8::Isolate::TryGetCurrent();
+    if (!isolate || !isolate->InContext()) {
+      return false;
+    }
+    v8::HandleScope handle_scope(isolate);
+    context = CurrentExecutionContext(isolate);
+    if (!context) {
+      return false;
+    }
+  }
+  *key = context->AeriumNoiseKey();
+  return true;
+}
+
+}  // namespace
