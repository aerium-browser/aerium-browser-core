+
+namespace blink {
+
+namespace {
+
+BASE_FEATURE(kAeriumFingerprintNoise, base::FEATURE_ENABLED_BY_DEFAULT);
+
+std::atomic<FingerprintNoise::KeyProvider> g_key_provider{nullptr};
+
+uint64_t Mix(uint64_t value) {
+  value += 0x9e3779b97f4a7c15ull;
+  value = (value ^ (value >> 30)) * 0xbf58476d1ce4e5b9ull;
+  value = (value ^ (value >> 27)) * 0x94d049bb133111ebull;
+  return value ^ (value >> 31);
+}
+
+uint64_t SessionSecret() {
+  static const uint64_t secret = [] {
+    uint64_t value = 0;
+    if (base::CommandLine::InitializedForCurrentProcess() &&
+        base::StringToUint64(
+            base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+                "aerium-fp-session"),
+            &value)) {
+      return value;
+    }
+    return base::RandUint64();
+  }();
+  return secret;
+}
+
+double Factor(uint64_t key) {
+  const uint64_t step = Mix(key) % 2000;
+  const double offset = step < 1000 ? static_cast<double>(step) - 1000.0
+                                    : static_cast<double>(step) - 999.0;
+  return 1.0 + offset * 1e-7;
+}
+
+bool HasByteChannels(const SkPixmap& pixmap) {
+  return pixmap.addr() && (pixmap.colorType() == kRGBA_8888_SkColorType ||
+                           pixmap.colorType() == kBGRA_8888_SkColorType);
+}
+
+}  // namespace
+
+bool FingerprintNoise::IsEnabled() {
+  return base::FeatureList::IsEnabled(kAeriumFingerprintNoise);
+}
+
+void FingerprintNoise::SetKeyProvider(KeyProvider provider) {
+  g_key_provider.store(provider, std::memory_order_release);
+}
+
+uint64_t FingerprintNoise::KeyForSite(const String& site) {
+  std::string input = base::NumberToString(SessionSecret());
+  input.push_back('|');
+  input.append(site.Utf8());
+  const std::string digest = base::SHA1HashString(input);
+  uint64_t key = 0;
+  for (size_t i = 0; i < sizeof(key); ++i) {
+    key = (key << 8) | static_cast<uint8_t>(digest[i]);
+  }
+  return key;
+}
+
+uint64_t FingerprintNoise::CurrentKey() {
+  uint64_t key = 0;
+  const KeyProvider provider = g_key_provider.load(std::memory_order_acquire);
+  if (provider && provider(&key)) {
+    return key;
+  }
+  static const uint64_t fallback = KeyForSite(String());
+  return fallback;
+}
+
+void FingerprintNoise::AddToPixels(const SkPixmap& pixmap,
+                                   int origin_x,
+                                   int origin_y) {
+  if (!IsEnabled() || !HasByteChannels(pixmap)) {
+    return;
+  }
+  AddToPixels(pixmap, origin_x, origin_y, CurrentKey());
+}
+
+void FingerprintNoise::AddToPixels(const SkPixmap& pixmap,
+                                   int origin_x,
+                                   int origin_y,
+                                   uint64_t key) {
+  if (!IsEnabled() || !HasByteChannels(pixmap)) {
+    return;
+  }
+  base::span<uint8_t> bytes = gfx::SkPixmapToWritableSpan(pixmap);
+  const size_t row_bytes = pixmap.rowBytes();
+  for (int y = 0; y < pixmap.height(); ++y) {
+    for (int x = 0; x < pixmap.width(); ++x) {
+      const size_t offset =
+          static_cast<size_t>(y) * row_bytes + static_cast<size_t>(x) * 4;
+      if (bytes[offset + 3] != 0xff) {
+        continue;
+      }
+      const uint64_t position =
+          (static_cast<uint64_t>(static_cast<uint32_t>(origin_y + y)) << 32) |
+          static_cast<uint32_t>(origin_x + x);
+      const uint64_t hash = Mix(key ^ position);
+      if ((hash & 31) != 0) {
+        continue;
+      }
+      bytes[offset + (hash >> 5) % 3] ^= 1;
+    }
+  }
+}
+
+SkPixmap FingerprintNoise::ForEncoding(const SkPixmap& pixmap,
+                                       Vector<uint8_t>& storage,
+                                       uint64_t key) {
+  if (!IsEnabled() || !HasByteChannels(pixmap)) {
+    return pixmap;
+  }
+  base::span<const uint8_t> source = gfx::SkPixmapToSpan(pixmap);
+  storage.resize(base::checked_cast<wtf_size_t>(source.size()));
+  base::span(storage).copy_from(source);
+  SkPixmap copy(pixmap.info(), storage.data(), pixmap.rowBytes());
+  AddToPixels(copy, 0, 0, key);
+  return copy;
+}
+
+double FingerprintNoise::Scale(double value) {
+  return IsEnabled() ? value * Factor(CurrentKey()) : value;
+}
+
+gfx::RectF FingerprintNoise::Scale(const gfx::RectF& rect) {
+  if (!IsEnabled()) {
+    return rect;
+  }
+  return gfx::ScaleRect(rect, static_cast<float>(Factor(CurrentKey())));
+}
+
+gfx::QuadF FingerprintNoise::Scale(const gfx::QuadF& quad) {
+  gfx::QuadF scaled = quad;
+  if (IsEnabled()) {
+    scaled.Scale(static_cast<float>(Factor(CurrentKey())));
+  }
+  return scaled;
+}
+
+}  // namespace blink
