+uint64_t ExecutionContext::AeriumNoiseKey() {
+  if (!aerium_noise_key_) {
+    String site = AeriumTopLevelSite();
+    if (site.empty()) {
+      const SecurityOrigin* origin = GetSecurityOrigin();
+      if (auto* window = DynamicTo<LocalDOMWindow>(this)) {
+        if (LocalFrame* frame = window->GetFrame()) {
+          if (const SecurityOrigin* top =
+                  frame->Top()->GetSecurityContext()->GetSecurityOrigin()) {
+            origin = top;
+          }
+        }
+      } else if (auto* worker = DynamicTo<WorkerGlobalScope>(this)) {
+        if (worker->top_level_frame_security_origin()) {
+          origin = worker->top_level_frame_security_origin();
+        }
+      }
+      if (origin) {
+        site = BlinkSchemefulSite(base::WrapRefCounted(origin)).Serialize();
+      }
+    }
+    aerium_noise_key_ = FingerprintNoise::KeyForSite(site);
+  }
+  return *aerium_noise_key_;
+}
+
 SecurityOrigin* ExecutionContext::GetMutableSecurityOrigin() {
   return security_context_.GetMutableSecurityOrigin();
 }
