+bool WebGLRenderingContextBase::AeriumReadPixelsLayout(GLsizei width,
+                                                       size_t* start,
+                                                       size_t* stride) {
+  const WebGLImageConversion::PixelStoreParams pack =
+      GetPackPixelStoreParams();
+  if (pack.row_length > 0 && pack.row_length < width) {
+    return false;
+  }
+  const size_t row_pixels =
+      static_cast<size_t>(pack.row_length > 0 ? pack.row_length : width);
