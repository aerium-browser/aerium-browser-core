+++ b/content/browser/web_contents/web_contents_impl.cc
@@ -832,6 +832,15 @@ WebContents* WebContents::FromRenderViewHost(RenderViewHost* rvh) {
       static_cast<RenderViewHostImpl*>(rvh)->GetDelegate());
 }
 
+bool WebContents::IsBrowserContextInUse(BrowserContext* browser_context) {
+  for (WebContentsImpl* web_contents : WebContentsImpl::GetAllWebContents()) {
+    if (web_contents->GetBrowserContext() == browser_context) {
+      return true;
+    }
+  }
+  return false;
+}
+
 WebContents* WebContents::FromRenderFrameHost(RenderFrameHost* rfh) {
   OPTIONAL_TRACE_EVENT1(TRACE_DISABLED_BY_DEFAULT("content.verbose"),
                         "WebContents::FromRenderFrameHost", "render_frame_host",
