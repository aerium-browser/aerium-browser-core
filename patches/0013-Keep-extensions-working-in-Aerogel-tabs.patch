 6 files changed, 30 insertions(+), 12 deletions(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java b/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
index aff846c2f46de970e2f698230702487b4521ff94..4bb8cf21c56a1582808b45fe4360429a0b498bfc 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
@@ -1320,15 +1320,17 @@ public class ChromeTabbedActivity extends ChromeActivity implements PreAttachInt
                         defaultPaneId);
         // TODO(crbug.com/444024982): Preserve default pane via PaneListBuilder.
         var builder = hubProvider.getPaneListBuilder();
-        if (!IncognitoUtils.shouldOpenIncognitoAsWindow()
-                || mSupportedProfileType == SupportedProfileType.REGULAR) {
+        boolean singleProfileWindow =
+                IncognitoUtils.shouldOpenIncognitoAsWindow()
+                        && mSupportedProfileType != SupportedProfileType.MIXED;
+        if (!singleProfileWindow || mSupportedProfileType == SupportedProfileType.REGULAR) {
             builder.registerPane(
                     PaneId.TAB_SWITCHER,
                     LazyOneshotSupplier.fromSupplier(() -> createTabSwitcherPane(false)));
             builder.registerPane(
                     PaneId.TAB_GROUPS, LazyOneshotSupplier.fromSupplier(this::createTabGroupsPane));
         }
-        if (!IncognitoUtils.shouldOpenIncognitoAsWindow()
+        if (!singleProfileWindow
                 || mSupportedProfileType == SupportedProfileType.OFF_THE_RECORD) {
             builder.registerPane(
                     PaneId.INCOGNITO_TAB_SWITCHER,
diff --git a/chrome/browser/incognito/android/java/src/org/chromium/chrome/browser/incognito/IncognitoUtils.java b/chrome/browser/incognito/android/java/src/org/chromium/chrome/browser/incognito/IncognitoUtils.java
