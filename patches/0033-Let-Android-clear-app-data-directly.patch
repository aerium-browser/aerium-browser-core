Subject: [PATCH] Let Android clear app data directly

---
 chrome/android/java/AndroidManifest.xml | 1 -
 1 file changed, 1 deletion(-)

diff --git a/chrome/android/java/AndroidManifest.xml b/chrome/android/java/AndroidManifest.xml
index c1de007fc1cfb008bd58b2826ca080cc2daa2a05..1ee34abbcf9a63cefc3ad84c39a92d7d08ea092f 100644
--- a/chrome/android/java/AndroidManifest.xml
+++ b/chrome/android/java/AndroidManifest.xml
@@ -224,7 +224,6 @@ by a child template that "extends" this file.
         android:label="{% block application_label %}@string/app_name{% endblock %}"
         android:memtagMode="async"
         android:largeHeap="false"
-        android:manageSpaceActivity="@string/manage_space_activity"
         android:supportsRtl="true"
         android:zygotePreloadName="org.chromium.content_public.app.ZygotePreload"
         {% if backup_key is defined %}
