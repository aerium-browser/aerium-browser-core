From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fatih-gh <me@mehmetfatihyaman.me>
Date: Thu, 1 Jan 2026 00:00:00 +0000
Subject: [PATCH] Bring back the version code override

---
 build/config/android/config.gni           | 2 ++
 build/config/android/rules.gni            | 4 ++++
 chrome/android/chrome_public_apk_tmpl.gni | 4 ++++
 3 files changed, 10 insertions(+)

diff --git a/build/config/android/config.gni b/build/config/android/config.gni
index b2141d010daeece3227647656e9457ffdbc786f7..5a5e76375ee569919bbc70025396d8f3d812bd68 100644
--- a/build/config/android/config.gni
+++ b/build/config/android/config.gni
@@ -238,6 +238,8 @@ if (is_android) {
   android_default_version_name = "9999.0.9999.9999"
 
   declare_args() {
+    android_override_version_code = ""
+
     android_ndk_api_level = default_min_sdk_version
 
     if (current_cpu == "riscv64" && default_min_sdk_version < 37) {
diff --git a/build/config/android/rules.gni b/build/config/android/rules.gni
index e36929c35a0fbd5ddc407a7bac1cafc0fa11acb5..284bcc482a111acdf6580baa1a2bd0100dbdb5e9 100644
--- a/build/config/android/rules.gni
+++ b/build/config/android/rules.gni
@@ -2360,6 +2360,10 @@ if (!is_robolectric && enable_java_templates) {
       _version_code = android_default_version_code
     }
 
+    if (android_override_version_code != "") {
+      _version_code = android_override_version_code
+    }
+
     if (defined(invoker.version_name)) {
       _version_name = invoker.version_name
     } else {
diff --git a/chrome/android/chrome_public_apk_tmpl.gni b/chrome/android/chrome_public_apk_tmpl.gni
index 1f3bd38b356c7e252c46aceebb8874e8e79c15b2..71400e1c1f0c9b39b0a0d7714815a7f461769a66 100644
--- a/chrome/android/chrome_public_apk_tmpl.gni
+++ b/chrome/android/chrome_public_apk_tmpl.gni
@@ -172,6 +172,10 @@ template("chrome_common_apk_or_module_tmpl") {
     _version_code = invoker.version_code
   }
 
+  if (android_override_version_code != "") {
+    _version_code = android_override_version_code
+  }
+
   if (defined(invoker.manifest_package)) {
     _manifest_package = invoker.manifest_package
   } else if (_is_test) {
