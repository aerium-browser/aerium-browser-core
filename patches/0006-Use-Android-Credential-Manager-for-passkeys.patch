From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fatih-gh <me@mehmetfatihyaman.me>
Date: Thu, 1 Jan 2026 00:00:00 +0000
Subject: [PATCH] Use Android Credential Manager for passkeys

---
 .../components/webauthn/AuthenticatorImpl.java         | 10 ++++++++--
 .../components/webauthn/Fido2CredentialRequest.java    |  3 +--
 .../webauthn/cred_man/CredManSupportProvider.java      |  8 +++-----
 3 files changed, 12 insertions(+), 9 deletions(-)

diff --git a/components/webauthn/android/java/src/org/chromium/components/webauthn/AuthenticatorImpl.java b/components/webauthn/android/java/src/org/chromium/components/webauthn/AuthenticatorImpl.java
index 6b16b28446c4085c5d01e6e543ad1701859672a3..2dde3d01ce57ec3298f4a9d3cce5d46e61549f60 100644
--- a/components/webauthn/android/java/src/org/chromium/components/webauthn/AuthenticatorImpl.java
+++ b/components/webauthn/android/java/src/org/chromium/components/webauthn/AuthenticatorImpl.java
@@ -360,8 +360,14 @@ public final class AuthenticatorImpl implements Authenticator, AuthenticationCon
         mPendingFido2CredentialRequest.handleReportRequest(options, assertNonNull(mOrigin));
     }
 
+    private static boolean hasWebauthnBackend() {
+        return GmsCoreUtils.isWebauthnSupported()
+                || CredManSupportProvider.getCredManSupport()
+                        == CredManSupport.FULL_UNLESS_INAPPLICABLE;
+    }
+
     private boolean couldSupportConditionalMediation() {
-        return GmsCoreUtils.isWebauthnSupported() && isChrome(mWebContents);
+        return hasWebauthnBackend() && isChrome(mWebContents);
     }
 
     /**
@@ -371,7 +377,7 @@ public final class AuthenticatorImpl implements Authenticator, AuthenticationCon
      */
     private boolean hasCredentialBackend() {
         if (isChrome(mWebContents)) {
-            return GmsCoreUtils.isWebauthnSupported();
+            return hasWebauthnBackend();
         }
         return (GmsCoreUtils.isWebauthnSupported() && GmsCoreUtils.isResultReceiverSupported())
                 || CredManSupportProvider.getCredManSupportForWebView() != CredManSupport.DISABLED;
diff --git a/components/webauthn/android/java/src/org/chromium/components/webauthn/Fido2CredentialRequest.java b/components/webauthn/android/java/src/org/chromium/components/webauthn/Fido2CredentialRequest.java
index e580b59514a244331d818edf5ea7d026137d7bc2..c3c2841e5382c42a9b51666cb51b00ff740d293d 100644
--- a/components/webauthn/android/java/src/org/chromium/components/webauthn/Fido2CredentialRequest.java
+++ b/components/webauthn/android/java/src/org/chromium/components/webauthn/Fido2CredentialRequest.java
@@ -430,8 +430,7 @@ public class Fido2CredentialRequest implements WebauthnBrowserBridge.Provider {
         //
         // Payments requests are also routed to Play Services since we haven't
         // defined how SPC works in CredMan yet.
-        if (!rkDiscouraged
-                && !options.isPaymentCredentialCreation
+        if (!options.isPaymentCredentialCreation
                 && getBarrierMode() == Barrier.Mode.ONLY_CRED_MAN) {
             int result =
                     mCredManHelper.startMakeRequest(
diff --git a/components/webauthn/android/java/src/org/chromium/components/webauthn/cred_man/CredManSupportProvider.java b/components/webauthn/android/java/src/org/chromium/components/webauthn/cred_man/CredManSupportProvider.java
index 7c34e180e73fc6e6df643161e7664297935c2885..741648ddc2e1f6bc1c71ec905272a6b533e62615 100644
--- a/components/webauthn/android/java/src/org/chromium/components/webauthn/cred_man/CredManSupportProvider.java
+++ b/components/webauthn/android/java/src/org/chromium/components/webauthn/cred_man/CredManSupportProvider.java
@@ -93,10 +93,7 @@ public class CredManSupportProvider {
                         == WebauthnMode.CHROME_3PP_ENABLED;
         // In CHROME_3PP_ENABLED mode Chrome does not use FIDO2 APIs parallel with CredMan. This
         // is because Chrome's Password Manager capabilities are disabled.
-        sCredManSupport =
-                gpmInCredMan || isChrome3pPwmMode
-                        ? CredManSupport.FULL_UNLESS_INAPPLICABLE
-                        : CredManSupport.PARALLEL_WITH_FIDO_2;
+        sCredManSupport = CredManSupport.FULL_UNLESS_INAPPLICABLE;
         log(TAG, "Support is %d", sCredManSupport);
         return sCredManSupport;
     }
@@ -153,7 +150,8 @@ public class CredManSupportProvider {
         assert sOverrideAndroidVersion == null : "Don't use in testing!";
         // The check works for unavailable and low GMS versions. `getGmsCoreVersion()` is -1 if the
         // GMS version can't be retrieved. Chrome assumes an insufficient GMS availability then.
-        return GmsCoreUtils.getGmsCoreVersion() < getMinGmsVersionForCurrentChannel();
+        int version = GmsCoreUtils.getGmsCoreVersion();
+        return version > 0 && version < getMinGmsVersionForCurrentChannel();
     }
 
     private static int getAndroidVersion() {
