 chrome/browser/ntp_tiles/chrome_most_visited_sites_factory.cc | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/chrome/browser/ntp_tiles/chrome_most_visited_sites_factory.cc b/chrome/browser/ntp_tiles/chrome_most_visited_sites_factory.cc
index 4b4132f9dfebed2bc97868492313d33f6ec4760a..c86be70f77564b42c2c64b3765cb7018b50439fe 100644
--- a/chrome/browser/ntp_tiles/chrome_most_visited_sites_factory.cc
+++ b/chrome/browser/ntp_tiles/chrome_most_visited_sites_factory.cc
@@ -85,11 +85,7 @@ ChromeMostVisitedSitesFactory::NewForProfile(Profile* profile) {
       supervised_user::SupervisedUserUrlFilteringServiceFactory::GetForProfile(
           profile),
       TopSitesFactory::GetForProfile(profile),
-#if BUILDFLAG(IS_ANDROID)
-      ChromePopularSitesFactory::NewForProfile(profile),
-#else
       nullptr,
-#endif
       ShouldCreateCustomLinksManager()
           ? ChromeCustomLinksManagerFactory::NewForProfile(profile)
           : nullptr,
