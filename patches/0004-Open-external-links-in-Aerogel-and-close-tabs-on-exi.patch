From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fatih-gh <me@mehmetfatihyaman.me>
Date: Thu, 1 Jan 2026 00:00:00 +0000
Subject: [PATCH] Open external links in Aerogel and close tabs on exit

---
 .../chrome/browser/ChromeTabbedActivity.java     |  5 ++++-
 .../chrome/browser/LaunchIntentDispatcher.java   | 16 ++++++++++++++++
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java b/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
index eb3e5785daad6ea265e0497a8c918af330c398c9..d536a1c832561e3f73c1ceefc45e01d3fe996415 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
@@ -50,6 +50,8 @@ import androidx.lifecycle.Lifecycle;
 import androidx.lifecycle.LifecycleObserver;
 import androidx.lifecycle.LifecycleRegistry;
 
+import com.aeriumbrowser.android.bridge.AeriumPrefs;
+
 import org.chromium.base.ActivityState;
 import org.chromium.base.ApkInfo;
 import org.chromium.base.ApplicationStatus;
@@ -2598,7 +2600,8 @@ public class ChromeTabbedActivity extends ChromeActivity implements PreAttachInt
             }
 
             boolean noRestoreState =
-                    CommandLine.getInstance().hasSwitch(ChromeSwitches.NO_RESTORE_STATE);
+                    CommandLine.getInstance().hasSwitch(ChromeSwitches.NO_RESTORE_STATE)
+                            || AeriumPrefs.startWithoutTabs(getSavedInstanceState() != null);
             boolean shouldShowNtpAsHomeSurfaceAtStartup = false;
             final AtomicBoolean isActiveUrlNtp = new AtomicBoolean(false);
             if (noRestoreState) {
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcher.java b/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcher.java
index 3429f1cf1b3d714ef0b2a657fc2b71b3a0c2fab9..e8c1a0bfc2e388dfd6eebf11f4dd7e3686685be4 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcher.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcher.java
@@ -21,6 +21,8 @@ import androidx.browser.customtabs.CustomTabsIntent;
 import androidx.browser.customtabs.TrustedWebUtils;
 import androidx.core.os.BuildCompat;
 
+import com.aeriumbrowser.android.bridge.AeriumPrefs;
+
 import org.chromium.base.ApiCompatibilityUtils;
 import org.chromium.base.ApplicationStatus;
 import org.chromium.base.CommandLine;
@@ -118,6 +120,9 @@ public class LaunchIntentDispatcher {
     public static @Action int dispatchToCustomTabActivity(Activity currentActivity, Intent intent) {
         LaunchIntentDispatcher dispatcher = new LaunchIntentDispatcher(currentActivity, intent);
         if (!isCustomTabIntent(dispatcher.mIntent)) return Action.CONTINUE;
+        if (AeriumPrefs.get(AeriumPrefs.EXTERNAL_LINKS_IN_AEROGEL)) {
+            return dispatcher.dispatchToTabbedActivity();
+        }
         if (shouldOverrideAlwaysOpenInBrowser(dispatcher.mIntent)) {
             RecordUserAction.record("CustomTabs.AlwaysOpenInBrowserOverride");
             return dispatcher.dispatchToTabbedActivity();
@@ -314,6 +319,12 @@ public class LaunchIntentDispatcher {
         mIntent = assertNonNull(IntentUtils.sanitizeIntent(intent));
     }
 
+    private static boolean isWebUrl(@Nullable String url) {
+        if (url == null) return false;
+        String scheme = Uri.parse(url).getScheme();
+        return "http".equals(scheme) || "https".equals(scheme);
+    }
+
     /** When started with an intent, maybe pre-resolve the domain. */
     private void maybePrefetchDnsInBackground() {
         if (Intent.ACTION_VIEW.equals(mIntent.getAction())) {
@@ -577,6 +588,11 @@ public class LaunchIntentDispatcher {
             if (!chromeTabbedTaskExists(mActivity)) {
                 newIntent.putExtra(IntentHandler.EXTRA_STARTED_TABBED_CHROME_TASK, true);
             }
+            if (AeriumPrefs.get(AeriumPrefs.EXTERNAL_LINKS_IN_AEROGEL)
+                    && isWebUrl(IntentHandler.getUrlFromIntent(newIntent))) {
+                newIntent.putExtra(IntentHandler.EXTRA_OPEN_NEW_INCOGNITO_TAB, true);
+                IntentUtils.addTrustedIntentExtras(newIntent);
+            }
             if ((newIntent.getFlags() & Intent.FLAG_ACTIVITY_NEW_TASK) != 0) {
                 // Adjacent launch flag, if present, already would have made the launcher activity
                 // start on the adajcent screen in multi-window mode. Clear it on the new Intent for
