From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fatih-gh <me@mehmetfatihyaman.me>
Date: Thu, 1 Jan 2026 00:00:00 +0000
Subject: [PATCH] Add core build targets

---
 chrome/android/BUILD.gn       | 7 +++++++
 chrome/browser/BUILD.gn       | 5 ++++-
 chrome/browser/prefs/BUILD.gn | 2 ++
 3 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/chrome/android/BUILD.gn b/chrome/android/BUILD.gn
index 271801af5323ad07e60e701d575e3f16b7d2f58f..4461a27684f886bbd97f3665976f317cf81f56ad 100644
--- a/chrome/android/BUILD.gn
+++ b/chrome/android/BUILD.gn
@@ -8,6 +8,7 @@ import("//build/toolchain/gcc_toolchain.gni")
 
 import("//chrome/android/chrome_common_shared_library.gni")
 import("//chrome/android/modules/chrome_feature_module_tmpl.gni")
+import("//aerium/bridge/bridge_sources.gni")
 import("//components/supervised_user/buildflags.gni")
 
 assert(!is_cronet_build)
@@ -312,6 +313,7 @@ if (_is_default_toolchain) {
 
   android_library("chrome_java") {
     deps = [
+      "//aerium/api:api_java",
       ":base_module_java",
       ":chrome_app_java_resources",
       ":chrome_public_apk_template_resources",
@@ -905,6 +907,10 @@ if (_is_default_toolchain) {
 
     # From java_sources.gni.
     sources = chrome_java_sources
+    sources += aerium_bridge_java_sources
+    if (aerium_ui_java != "") {
+      deps += [ aerium_ui_java ]
+    }
 
     # Include sources from feed_java_sources.gni.
     sources += feed_java_sources
@@ -2954,6 +2960,7 @@ if (_is_default_toolchain) {
 
   generate_jni("chrome_jni_headers") {
     sources = [
+      "//aerium/bridge/java/src/com/aeriumbrowser/android/bridge/ExtensionsImpl.java",
       "../browser/share/android/java/src/org/chromium/chrome/browser/share/BitmapDownloadRequest.java",
       "../browser/share/android/java/src/org/chromium/chrome/browser/share/link_to_text/LinkToTextBridge.java",
       "../browser/share/android/java/src/org/chromium/chrome/browser/share/long_screenshots/bitmap_generation/LongScreenshotsTabService.java",
diff --git a/chrome/browser/BUILD.gn b/chrome/browser/BUILD.gn
index 814b9d649a31646c7bc072d882a5e11b70d5d6d6..93cc3934c732fd4d60ca2f1b114d7ed9888de76b 100644
--- a/chrome/browser/BUILD.gn
+++ b/chrome/browser/BUILD.gn
@@ -3593,7 +3593,10 @@ source_set("browser") {
   # TODO(https://crbug.com/356905053): Add more dependencies here and merge this
   # block with the `enable_extensions` block above.
   if (enable_desktop_android_extensions) {
-    deps += [ "//chrome/browser/ui/android/extensions" ]
+    deps += [
+      "//aerium/bridge:native",
+      "//chrome/browser/ui/android/extensions",
+    ]
   }
 
   if (enable_library_cdms) {
diff --git a/chrome/browser/prefs/BUILD.gn b/chrome/browser/prefs/BUILD.gn
index 66f9c0d285f331355dd808c821307c0467933a4f..279865a0ae9a1c3c44e9ac2844c71aeb932d0179 100644
--- a/chrome/browser/prefs/BUILD.gn
+++ b/chrome/browser/prefs/BUILD.gn
@@ -47,6 +47,8 @@ source_set("prefs") {
 
 source_set("impl") {
   sources = [
+    "//aerium/defaults/aerium_defaults.cc",
+    "//aerium/defaults/aerium_defaults.h",
     "browser_prefs.cc",
     "chrome_command_line_pref_store.cc",
     "chrome_pref_model_associator_client.cc",
