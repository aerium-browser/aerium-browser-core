+++ b/chrome/browser/ui/android/appmenu/java/src/org/chromium/chrome/browser/ui/appmenu/AppMenuSheet.java
@@ -0,0 +1,42 @@
+// Copyright 2026 Dioide
+// SPDX-License-Identifier: GPL-3.0-only
+
+package org.chromium.chrome.browser.ui.appmenu;
+
+import android.content.Context;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.ui.modelutil.MVCListAdapter.ModelList;
+
+@NullMarked
+public final class AppMenuSheet {
+    public interface Host {
+        void select(int id);
+
+        void dismissed();
+    }
+
+    public interface Session {
+        boolean isShowing();
+
+        void dismiss();
+    }
+
+    public interface Presenter {
+        @Nullable
+        Session show(Context context, ModelList items, Host host);
+    }
+
+    private static @Nullable Presenter sPresenter;
+
+    private AppMenuSheet() {}
+
+    public static void setPresenter(@Nullable Presenter presenter) {
+        sPresenter = presenter;
+    }
+
+    public static @Nullable Presenter getPresenter() {
+        return sPresenter;
+    }
+}
