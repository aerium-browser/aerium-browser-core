From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fatih-gh <me@mehmetfatihyaman.me>
Date: Thu, 1 Jan 2026 00:00:00 +0000
Subject: [PATCH] Show no stock tips or promos

---
 components/feature_engagement/internal/tracker_impl.cc | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/components/feature_engagement/internal/tracker_impl.cc b/components/feature_engagement/internal/tracker_impl.cc
index 48bff18c643e1becb68b0650ae78bd215f509a3c..eb364be6bcfc98b953eea7886e72cdd86ee91ac8 100644
--- a/components/feature_engagement/internal/tracker_impl.cc
+++ b/components/feature_engagement/internal/tracker_impl.cc
@@ -63,6 +63,10 @@ namespace {
 const char kEventDBName[] = "EventDB";
 const char kAvailabilityDBName[] = "AvailabilityDB";
 
+bool HidesStockHelp() {
+  return BUILDFLAG(IS_ANDROID);
+}
+
 #if !BUILDFLAG(IS_ANDROID)
 
 // Reads event data from `config` and - if valid - places it into `result` along
@@ -343,7 +347,7 @@ TrackerImpl::TriggerDetails TrackerImpl::ShouldTriggerHelpUIWithSnooze(
   if (session_controller_ && session_controller_->ShouldResetSession()) {
     condition_validator_->ResetSession();
   }
-  if (IsFeatureBlockedByTest(feature)) {
+  if (IsFeatureBlockedByTest(feature) || HidesStockHelp()) {
     return TriggerDetails(false, false);
   }
 
@@ -406,7 +410,7 @@ bool TrackerImpl::WouldTriggerHelpUI(const base::Feature& feature) const {
     condition_validator_->ResetSession();
   }
 
-  if (IsFeatureBlockedByTest(feature)) {
+  if (IsFeatureBlockedByTest(feature) || HidesStockHelp()) {
     return false;
   }
 
